<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Thumbnail -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="64dp"
        android:layout_marginEnd="12dp"
        android:background="#f0f0f0">

        <ImageView
            android:id="@+id/screenThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Screen thumbnail" />

        <TextView
            android:id="@+id/screenEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="📭"
            android:textSize="24sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/screenLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Экран 1"
            android:textColor="#1d1d1f"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/screenInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Нет контента"
            android:textColor="#6e6e73"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Selection indicator -->
    <View
        android:id="@+id/screenSelected"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:background="#007AFF"
        android:visibility="gone" />

</LinearLayout>
