{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": [
    {
      "rules": "storage.rules",
      "bucket": "kava-signage-2026.firebasestorage.app"
    }
  ],
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "kava-signage-2026",
    "public": "admin-panel",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
